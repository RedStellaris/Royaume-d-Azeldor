{
  "namespace": "server_helper:trade",
  "root": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 20 } },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "size": [176, 222],
          "controls": [
            { "common_panel@common.common_panel": {} },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "top_half@server_helper:trade.top_half": { "offset": [-6, 10] } },
                  { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
                  { "hotbar_grid@common.hotbar_grid_template": {} }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "ui_title": {
    "type": "label",
    "text": "\u00a7b\u00a7lTrade \u00a7f- \u00a73Server Helper",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [12, -3],
    "color": "$title_text_color"
  },
  "your_offer_label": {
    "type": "label",
    "text": "\u00a79\u25bc YOUR OFFER \u25bc",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [12, 8],
    "color": "$title_text_color"
  },
  "their_offer_label": {
    "type": "label",
    "text": "\u00a76\u25bc THEIR OFFER \u25bc",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [12, 56],
    "color": "$title_text_color"
  },
  "trade_slot": {
    "type": "stack_panel",
    "$index": 0,
    "collection_name": "container_items",
    "$slot_size": [18, 18],
    "$slot_image_size": [18, 18],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "slot@chest.chest_grid_item": {
          "ignored": false,
          "$cell_image_size": "$slot_image_size",
          "size": "$slot_size",
          "collection_index": "$index"
        }
      }
    ]
  },
  "top_half": {
    "type": "panel",
    "size": ["100%", 132],
    "offset": [0, 7],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      { "title@server_helper:trade.ui_title": {} },
      { "your_label@server_helper:trade.your_offer_label": {} },

      { "my_0@server_helper:trade.trade_slot": { "$index": 0, "offset": [12, 18] } },
      { "my_1@server_helper:trade.trade_slot": { "$index": 1, "offset": [30, 18] } },
      { "my_2@server_helper:trade.trade_slot": { "$index": 2, "offset": [48, 18] } },
