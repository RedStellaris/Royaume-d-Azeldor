{
  "namespace": "server_helper:spawnerv2",
  "root": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "flying_item_renderer@common.flying_item_renderer": { "layer": 20 } },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "size": [240, 210], 
          "controls": [
            { "common_panel@common.common_panel": {} },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "offset": [0, 0], 
                "controls": [
                  { "top_half@server_helper:spawnerv2.top_half": {} },
                  { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
                  { "hotbar_grid@common.hotbar_grid_template": {} }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "ui_title": {
    "type": "label",
    "text": "§2§lSimple Spawner §f- §3Server Helper",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [6, -3],
    "color": "$title_text_color"
  },
  "item_slot": {
    "type": "stack_panel",
    "$index": 0,
    "collection_name": "container_items",
    "$slot_size": [18, 18],
    "$slot_image_size": [18, 18],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "slot@chest.chest_grid_item": {
          "ignored": false,
          "$cell_image_size": "$slot_image_size",
          "size": "$slot_size",
          "collection_index": "$index"
        }
      }
    ]
  },
  "grid": {
    "type": "grid",
    "size": [216, 72], 
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [12, 4], 
    "grid_item_template": "chest.chest_grid_item",
    "collection_name": "container_items"
  },
  "top_half": {
      "type": "panel",
      "size": ["100%", 112],
      "offset": [0, 7],
      "anchor_to": "top_left",
      "anchor_from": "top_left",
      "controls": [
        { "title@server_helper:spawnerv2.ui_title": {} },
        { "sell@server_helper:spawnerv2.item_slot": { "$index": 48, "offset": [12, 8] } },
        { "add@server_helper:spawnerv2.item_slot": { "$index": 49, "offset": [30, 8] } },
        { "remove@server_helper:spawnerv2.item_slot": { "$index": 50, "offset": [48, 8] } },
        { "amount@server_helper:spawner.item_slot": { "$index": 51, "offset": [66, 8] } },
        { 
          "page_digit_1@server_helper:spawnerv2.item_slot": { 
            "$index": 52, 
            "offset": [110, 16], 
            "$slot_size": [0, 0], 
            "$slot_image_size": [0, 0] 
          } 
        },
        { 
          "page_digit_2@server_helper:spawnerv2.item_slot": { 
            "$index": 53, 
            "offset": [120, 16], 
            "$slot_size": [0, 0], 
            "$slot_image_size": [0, 0] 
          } 
        },

        { "back@server_helper:spawnerv2.item_slot": { "$index": 54, "offset": [174, 8] } },
        { "next@server_helper:spawnerv2.item_slot": { "$index": 55, "offset": [192, 8] } },
        { "grid@server_helper:spawnerv2.grid": { "offset": [12, 28] } }
      ]
    }
}